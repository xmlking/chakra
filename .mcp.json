{
  "mcpServers": {
    "better-auth": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "shadcn": {
      "command": "bunx",
      "args": ["shadcn@latest", "mcp"]
    },
    "assistant-ui": {
      "command": "bunx",
      "args": ["-y", "@assistant-ui/mcp-docs-server"]
    },
    "drizzle": {
      "command": "bunx",
      "args": ["drizzle-kit", "mcp"]
    },
    "reui": {
      "type": "http",
      "url": "https://mcp.reui.io",
      "headers": {
        "Authorization": "Bearer ${env:REUI_LICENSE_KEY}"
      }
    },
    "mcp-toolbox": {
      "type": "http",
      "url": "http://127.0.0.1:5010/mcp"
    }
  }
}
