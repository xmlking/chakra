# Local development environment example.
# Copy to .env.local and replace every <...> placeholder.

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=<generate-with-bunx---bun-auth@latest-secret>
BETTER_AUTH_JWT_EXPIRATION_TIME=365d

GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

FF_ENABLE_DARK_MODE=true

DATABASE_URL=

BETTER_AUTH_ADMINS=<comma-separated-admin-uuidv7-values>
BETTER_AUTH_ADMIN_EMAIL=<admin-email>
BETTER_AUTH_ADMIN_PASSWORD=<admin-password>
SHARED_ORGANIZATION_ID=<organization-uuidv7>

RESEND_API_KEY=<resend-api-key>
CONFIRM_REDIRECT_URL=http://localhost:3000/auth/confirm

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=${RESEND_API_KEY}

FILES_API_SECRET=<generate-with-openssl-rand-hex-32>
S3_ACCESS_KEY_ID=<s3-access-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key>

OPENAI_API_KEY=<openai-api-key>

# Optional docs and integration values.
GITHUB_TOKEN=<github-token>
OPENROUTER_API_KEY=
GITHUB_APP_ID=<github-app-id>
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
