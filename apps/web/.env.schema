# Web app contract (TanStack Start + Nitro).
#
# This is the process that actually runs, so it imports every workspace
# package it bundles; their items become part of this app's env. Values come
# from the root `.env.local` (development) or the container platform
# (production). The Vite plugin loads this file in dev/build; the built server
# is started through `varlock run` (see Dockerfile).
#
# Items with a value are required by default (`infer`); items without a default
# that must be set carry `@required`; everything else is optional. Secrets stay
# sensitive (the default); plain config is marked `@sensitive=false` so its
# values are not redacted from logs. Only `@public` items are read from browser code.
#
# The root import is filtered with `pick` so only the keys declared here reach
# this app directly; each package import brings its own picked keys.
#
# @import(../../, pick=[APP_ENV, APP_NAME, OPENAI_API_KEY, AI_GATEWAY_API_KEY, SENTRY_*, ONRAMP_SCHEDULER_CRON, WORKFLOW_*, FF_ENABLE_DARK_MODE])
# @import(../../packages/db/)
# @import(../../packages/email/)
# @import(../../packages/auth/)
# @import(../../packages/storage/)
# @generateTsTypes(path=./env.ts, exposeEnv=local)
# @defaultRequired=infer
# ---

# --- AI ---------------------------------------------------------------------

# Read by @ai-sdk/openai from process.env, which varlock populates at boot.
# @required @type=string(startsWith="sk-") @docs(https://platform.openai.com/api-keys)
OPENAI_API_KEY=

AI_GATEWAY_API_KEY=

# --- Sentry -----------------------------------------------------------------

SENTRY_AUTH_TOKEN=

# @sensitive=false
SENTRY_ORG=

# @sensitive=false
SENTRY_PROJECT=

# --- Nitro scheduled tasks --------------------------------------------------

# Cron expression; the default runs every minute.
# @sensitive=false
ONRAMP_SCHEDULER_CRON="* * * * *"

# --- Workflow SDK (postgres world) ------------------------------------------

# @sensitive=false
WORKFLOW_TARGET_WORLD="@workflow/world-postgres"

# Uses a dedicated workflow URL when set, otherwise falls back to DATABASE_URL.
WORKFLOW_POSTGRES_URL=fallback($DATABASE_URL, "")

# @sensitive=false
WORKFLOW_POSTGRES_JOB_PREFIX=chakra_job_

# @sensitive=false @type=number(isInt=true, min=1)
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=10

# @sensitive=false @type=number(isInt=true, min=1)
WORKFLOW_POSTGRES_MAX_POOL_SIZE=12

# --- Feature flags ----------------------------------------------------------
# Flags are `@public @dynamic`: the browser reads them via ENV after the boot
# script in src/routes/__root.tsx hydrates them, and `refreshPublicEnv()` in
# src/lib/public-env.ts re-fetches /api/public-env to pick up a flip at runtime.

# @public @dynamic @type=boolean
FF_ENABLE_DARK_MODE=false
