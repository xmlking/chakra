# Docs site contract (fumapress / waku).
#
# The GitHub Pages workflow builds this app with no secrets, so every item
# without a default is optional. Values come from the root `.env.local` locally
# and from the workflow `env:` block in CI (process env always wins).
#
# The root import is filtered with `pick` so only the keys declared here reach
# this app; other packages' values in the shared root `.env.local` stay out.
#
# @import(../../, pick=[APP_ENV, APP_NAME, APP_URL, DOCS_URL, DOCS_BASE_PATH, GITHUB_REPO, GITHUB_OWNER, DOCS_CATEGORY, GITHUB_TOKEN, OPENROUTER_*, GITHUB_APP_*])
# @generateTsTypes(path=./env.ts, exposeEnv=local)
# @defaultRequired=infer
# ---

# @public @type=url
APP_URL=http://localhost:3000

# @public @type=url
DOCS_URL=http://localhost:3001

# Base path the site is served from, e.g. `/chakra/` on GitHub Pages.
# @public @type=string(startsWith="/")
DOCS_BASE_PATH=/

# @public @type=string(minLength=3)
GITHUB_REPO=chakra

# @public @type=string(minLength=3)
GITHUB_OWNER=xmlking

# @public @type=string(minLength=3)
DOCS_CATEGORY=Documentation

# Optional token for the GitHub info widget (raises the API rate limit).
GITHUB_TOKEN=

# --- AI (docs assistant) ----------------------------------------------------

OPENROUTER_API_KEY=

# @sensitive=false
OPENROUTER_MODEL=

# --- GitHub App (feedback plugin) -------------------------------------------

# @sensitive=false
GITHUB_APP_ID=

# Private key must be in PKCS#8 format.
GITHUB_APP_PRIVATE_KEY=

GITHUB_APP_WEBHOOK_SECRET=
