{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#config/*": "./src/config/*",
    "#env": "./env.ts",
    "#features/*": "./src/features/*",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#server/*": "./src/server/*",
    "#types": [
      "./src/types/index.ts"
    ]
  },
  "scripts": {
    "build": "APP_ENV=build astro build",
    "clean": "git clean -xdf .astro dist test-results coverage node_modules",
    "codegen": "varlock codegen",
    "dev": "astro dev --port=3001",
    "postinstall": "varlock codegen && astro sync",
    "preview": "astro preview --port=3001",
    "types:check": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@base-ui/react": "catalog:",
    "@fumadocs/astro": "0.3.0",
    "@fumadocs/satteri": "0.8.2",
    "@fumapress/astro": "0.1.0",
    "@fumapress/blog": "0.1.0",
    "@fumapress/feedback": "2.0.0",
    "@fumapress/tegami": "2.0.0",
    "@thesvg/react": "catalog:",
    "@workspace/i18n": "workspace:*",
    "@workspace/shared": "workspace:*",
    "@workspace/ui": "workspace:*",
    "astro": "7.4.12",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "d3-force": "3.0.1",
    "fumadocs-core": "16.19.0",
    "fumadocs-openapi": "12.6.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.0",
    "lucide-react": "catalog:",
    "mermaid": "12.3.0",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-force-graph-2d": "1.29.2",
    "sharp": "0.35.5",
    "shiki": "catalog:",
    "takumi-js": "2.20.0",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/d3-force": "3.0.10",
    "@types/mdx": "2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@varlock/astro-integration": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "shiki": "catalog:",
    "typescript": "catalog:"
  }
}
