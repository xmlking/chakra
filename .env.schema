# Shared workspace config.
#
# Every package/app schema imports this directory with `@import(../../)`. That
# import also loads the git-ignored root `.env.local`, where developer secrets
# live, and `.env.build` when APP_ENV=build (Docker builds, schema tests).
#
# Nothing runs from the root, so items a specific package needs are declared in
# that package's own `.env.schema`. Only truly shared items live here.
#
# Everything is sensitive unless marked `@public`; only `@public` items may be
# read from browser code and get inlined into client bundles.
#
# `@currentEnv` lives here only: varlock requires the flag to be defined in the
# schema that declares it, and importers inherit it.
#
# Every schema uses `@defaultRequired=infer`: declared items with a value are
# required, empty ones are optional unless marked `@required`.
#
# Importers filter this directory with `pick=[...]`, so a key in `.env.local`
# only reaches a package that declares it. Keys nothing declares are ignored.
# When you add an item to a package schema, add it to that schema's pick list.
#
# @currentEnv=$APP_ENV
# @defaultRequired=infer
# ---

# Selects which `.env.[APP_ENV]` files are loaded on top of the schema.
# Docker image builds set `build`; the runtime image sets `production`.
# @public @type=enum(development, test, build, production)
APP_ENV=development

# Display name used by the web app (auth emails, titles) and the docs site.
# @public @type=string(minLength=3)
APP_NAME=Chakra AI
