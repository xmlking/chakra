{
  "inputs": [
    {
      "type": "promptString",
      "id": "reui-token",
      "description": "ReUI personal token (reui_pat_...)",
      "password": true
    }
  ],
  "servers": {
    "better-auth": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "shadcn": {
      "command": "vpx",
      "args": ["shadcn@latest", "mcp"]
    },
    "assistant-ui": {
      "command": "vpx",
      "args": ["-y", "@assistant-ui/mcp-docs-server"]
    },
    "drizzle": {
      "command": "vpx",
      "args": ["drizzle-kit", "mcp"]
    },
    "reui": {
      "type": "http",
      "url": "https://mcp.reui.io",
      "headers": {
        "Authorization": "Bearer ${input:reui-token}"
      }
    },
    "chrome-devtools": {
      "command": "vpx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "mcp-toolbox": {
      "type": "http",
      "url": "http://127.0.0.1:5010/mcp"
    },
    "queen": {
      "type": "http",
      "url": "https://queenmq.com/mcp"
    }
  }
}
