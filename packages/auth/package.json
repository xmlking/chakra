{
  "name": "@workspace/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Better-Auth module",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./*": "./src/*.ts",
    "./env": "./env.ts",
    "./studio.config": "./studio.config.ts"
  },
  "scripts": {
    "clean": "git clean -xdf env.ts dist test-results coverage node_modules",
    "codegen": "varlock codegen",
    "create-admin-user": "varlock run -- bun scripts/create-admin-user.ts",
    "create-admin-user-ori": "varlock run -- bunx auth@latest create-admin -c src/index.tsx --email $BETTER_AUTH_ADMIN_EMAIL --name=\"Super Admin\" --role admin",
    "generate-schema": "varlock run -- bunx auth@latest generate -c src/index.tsx --output ../db/src/schema/copy_me_auth.ts -y",
    "postinstall": "varlock codegen",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@better-auth/agent-auth": "catalog:",
    "@better-auth/api-key": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/infra": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@better-auth/stripe": "catalog:",
    "@workspace/db": "workspace:*",
    "@workspace/email": "workspace:*",
    "@workspace/shared": "workspace:*",
    "better-auth": "catalog:",
    "better-inbox": "catalog:",
    "react": "catalog:",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "auth": "catalog:",
    "uuid": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
