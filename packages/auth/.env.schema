# Auth package contract (Better Auth server + browser client).
#
# src/index.tsx reads db and email items too, so this schema imports those
# packages. The admin scripts in scripts/ run from here via `varlock run`; in
# the web app, apps/web/.env.schema imports this file so its process carries
# everything declared below.
#
# Items with a value are required by default (`infer`); items without a default
# that must be set carry `@required`; everything else is optional. Secrets stay
# sensitive (the default); plain config is marked `@sensitive=false` so its
# values are not redacted from logs. Only `@public` items are read from browser code.
#
# The root import is filtered with `pick` so only the keys declared here reach
# this package; db and email bring their own picked keys.
#
# @import(../../, pick=[APP_ENV, APP_NAME, BETTER_AUTH_URL, BETTER_AUTH_SECRET, BETTER_AUTH_JWT_EXPIRATION_TIME, GOOGLE_CLIENT_*, GITHUB_CLIENT_*, MICROSOFT_*, TURNSTILE_*])
# @import(../db/)
# @import(../email/)
# @generateTsTypes(path=./env.ts, exposeEnv=local)
# @defaultRequired=infer
# ---

# Public base URL of the app. The browser auth client and the files/images
# CORS allow-lists use it. `@dynamic`: resolved when the server boots instead of
# being inlined into the client bundle, so one image serves any host. The
# browser receives it through the boot script in apps/web/src/routes/__root.tsx.
# @required @public @dynamic @type=url
BETTER_AUTH_URL=

# Generate with `bunx --bun auth@latest secret`.
# @required @docs(https://www.better-auth.com/docs/installation#set-environment-variables)
BETTER_AUTH_SECRET=

# Passed to the JWT plugin as-is (e.g. 30m, 1h).
# @sensitive=false
BETTER_AUTH_JWT_EXPIRATION_TIME=30m

# --- Social providers (each enabled only when its pair is set) -------------

# Used by the browser for Google One Tap, so it is public.
# @public
GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# @sensitive=false
GITHUB_CLIENT_ID=

GITHUB_CLIENT_SECRET=

# @sensitive=false
MICROSOFT_CLIENT_ID=

MICROSOFT_CLIENT_SECRET=

# @sensitive=false
MICROSOFT_TENANT_ID=

# --- Cloudflare Turnstile captcha -----------------------------------------

# @public @type=boolean
TURNSTILE_ENABLED=false

# Always Passes - 1x00000000000000000000AA
# Always Fails  - 2x00000000000000000000AB
# Production    - 0x4AAAAAAA4jAyA4ZpiXqCVy
# Rendered by the Turnstile widget in the browser. `@dynamic`: per-deployment
# value, delivered at runtime rather than baked into the bundle.
# @required @public @dynamic @docs(https://developers.cloudflare.com/turnstile/get-started/)
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Always Passes - 1x0000000000000000000000000000000AA
# Always Fails  - 2x0000000000000000000000000000000AA
# @required
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
