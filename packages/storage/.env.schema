# Storage package contract (files-sdk + S3-compatible object storage).
#
# Values come from the workspace root (`.env.local`), imported below. This
# package runs no process of its own; apps/web imports this schema.
#
# Items with a value are required by default (`infer`); items without a default
# that must be set carry `@required`; everything else is optional. Secrets stay
# sensitive (the default); plain config is marked `@sensitive=false` so its
# values are not redacted from logs.
#
# The root import is filtered with `pick` so only the keys declared here reach
# this package; other packages' values in the shared root `.env.local` stay out.
#
# @import(../../, pick=[APP_ENV, APP_NAME, FILES_API_SECRET, S3_*])
# @generateTsTypes(path=./env.ts, exposeEnv=local)
# @defaultRequired=infer
# ---

# Signs files-sdk URLs. Generate with `openssl rand -hex 32`.
# @required @type=string(minLength=64)
FILES_API_SECRET=

# @sensitive=false @type=string(minLength=3)
S3_IMAGES_BUCKET=images

# @sensitive=false @type=string(minLength=3)
S3_FILES_BUCKET=files

# @sensitive=false @type=string(minLength=3)
S3_AGENTS_BUCKET=agents

# @sensitive=false
S3_REGION=us-east-1

# MinIO in local development (see infra/compose/storage.yml).
# @sensitive=false
S3_ENDPOINT=http://localhost:9000

# @required @type=string(minLength=3)
S3_ACCESS_KEY_ID=

# @required @type=string(minLength=8)
S3_SECRET_ACCESS_KEY=
