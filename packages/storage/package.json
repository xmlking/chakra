{
  "name": "@workspace/storage",
  "version": "0.0.0",
  "private": true,
  "description": "unified storage provider",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./env.ts"
  },
  "scripts": {
    "clean": "git clean -xdf dist test-results coverage node_modules",
    "codegen": "varlock codegen",
    "postinstall": "varlock codegen",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@workspace/shared": "workspace:*",
    "evlog": "catalog:",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@better-upload/server": "catalog:",
    "files-sdk": "catalog:",
    "typescript": "catalog:"
  }
}
