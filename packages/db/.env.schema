# Database package contract (Drizzle + node-postgres).
#
# drizzle-kit and the seed script run from this directory via `varlock run`
# (see package.json scripts). apps/web and packages/auth import this schema so
# their processes carry these items too.
#
# Items with a value are required by default (`infer`); items without a default
# that must be set carry `@required`; everything else is optional. Secrets stay
# sensitive (the default); plain config is marked `@sensitive=false` so its
# values are not redacted from logs.
#
# The root import is filtered with `pick` so only the keys declared here reach
# this package; other packages' values in the shared root `.env.local` stay out.
#
# @import(../../, pick=[APP_ENV, APP_NAME, DATABASE_URL, DB_POOL_*, BETTER_AUTH_ADMINS, BETTER_AUTH_ADMIN_*, SHARED_ORGANIZATION_ID])
# @generateTsTypes(path=./env.ts, exposeEnv=local)
# @defaultRequired=infer
# ---

# @required @type=url
DATABASE_URL=

# @sensitive=false @type=number(isInt=true, min=1, max=200)
DB_POOL_MIN=10

# @sensitive=false @type=number(isInt=true, min=1, max=200)
DB_POOL_MAX=10

# @sensitive=false @type=boolean
DB_POOL_SSL=false

# Comma-separated UUIDv7 user ids that are granted the admin role.
# varlock's built-in `uuid` type only accepts v1-v5, hence the regex.
# BETTER_AUTH_ADMINS="<admin-uuidv7-one>, <admin-uuidv7-two>"
# @required @sensitive=false @type=array(string(matches=/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i))
BETTER_AUTH_ADMINS=

# @required @sensitive=false @type=email
BETTER_AUTH_ADMIN_EMAIL=

# @required
BETTER_AUTH_ADMIN_PASSWORD=

# UUIDv7 of the organization every user is a member of (used by the seed script).
# @required @sensitive=false @type=string(matches=/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i)
SHARED_ORGANIZATION_ID=
