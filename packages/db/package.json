{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle database module",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./env": "./env.ts"
  },
  "scripts": {
    "check": "varlock run -- drizzle-kit check",
    "clean": "git clean -xdf .drizzle dist test-results coverage node_modules",
    "codegen": "varlock codegen",
    "export": "varlock run -- drizzle-kit export",
    "generate": "varlock run -- drizzle-kit generate",
    "mcp": "varlock run -- drizzle-kit mcp",
    "migrate": "varlock run -- drizzle-kit migrate",
    "postinstall": "varlock codegen",
    "pull": "varlock run -- drizzle-kit pull",
    "push": "varlock run -- drizzle-kit push",
    "seed": "varlock run -- bun scripts/seed.ts",
    "skills": "varlock run -- drizzle-kit skills",
    "studio": "varlock run -- drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "up": "varlock run -- drizzle-kit up",
    "workflow:bootstrap": "varlock run -- bun x --package @workflow/world-postgres@5.0.0-beta.36 bootstrap"
  },
  "dependencies": {
    "@workspace/shared": "workspace:*",
    "better-result": "catalog:",
    "drizzle-orm": "catalog:",
    "evlog": "catalog:",
    "pg": "catalog:",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/utils": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-seed": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
