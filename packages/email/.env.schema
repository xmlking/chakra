# Email package contract (react-email templates + email-sdk client).
#
# Values come from the workspace root (`.env.local`), imported below. This
# package runs no process of its own; apps/web and packages/auth import this
# schema so their processes carry these items.
#
# Items with a value are required by default (`infer`); items without a default
# that must be set carry `@required`; everything else is optional. Secrets stay
# sensitive (the default); plain config is marked `@sensitive=false` so its
# values are not redacted from logs.
#
# The root import is filtered with `pick` so only the keys declared here reach
# this package; other packages' values in the shared root `.env.local` stay out.
#
# @import(../../, pick=[APP_ENV, APP_NAME, EMAIL_FROM, EMAIL_TO, RESEND_*, CONFIRM_REDIRECT_URL, SENDGRID_API_KEY, PLUNK_API_KEY, POSTMARK_API_KEY, SMTP_*])
# @generateTsTypes(path=./env.ts, exposeEnv=local)
# @defaultRequired=infer
# ---

# @sensitive=false @type=email
EMAIL_FROM=onboarding@resend.dev

# @sensitive=false @type=email
EMAIL_TO=delivered@resend.dev

# @docs(https://resend.com/docs/api-reference/api-keys)
RESEND_API_KEY=

RESEND_WEBHOOK_SECRET=

# @sensitive=false
RESEND_AUDIENCE_ID=

# @sensitive=false
RESEND_TEMPLATE_ID=

# @sensitive=false @type=url
CONFIRM_REDIRECT_URL=

SENDGRID_API_KEY=

PLUNK_API_KEY=

POSTMARK_API_KEY=

# SMTP fallback adapter. Resend's relay is smtp.resend.com:465 with user `resend`.
# @required @sensitive=false
SMTP_HOST=

# @required @sensitive=false @type=port(min=1)
SMTP_PORT=

# @sensitive=false @type=boolean
SMTP_SECURE=false

# @sensitive=false
SMTP_USER=

# Defaults to the Resend API key, which is what Resend's SMTP relay expects.
# Explicitly optional: an item with a value expression would otherwise be
# inferred as required, and it resolves to empty when no Resend key is set.
# @optional
SMTP_PASS=${RESEND_API_KEY}
