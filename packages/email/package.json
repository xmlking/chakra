{
  "name": "@workspace/email",
  "version": "0.0.0",
  "private": true,
  "description": "Email templates",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ui/*": "./src/ui/email/*.tsx",
    "./*": "./emails/*.tsx",
    "./env": "./env.ts"
  },
  "scripts": {
    "build": "varlock run -- email build",
    "clean": "git clean -xdf .react-email dist out node_modules",
    "cli": "varlock run -- email-sdk",
    "codegen": "varlock codegen",
    "dev": "varlock run -- email dev --port 3010",
    "dev2": "varlock run -- email dev --dir src/ui/email --port 3010",
    "export": "varlock run -- email export --pretty",
    "postinstall": "varlock codegen",
    "start": "varlock run -- email start"
  },
  "dependencies": {
    "@opencoredev/email-sdk": "catalog:",
    "@workspace/ui": "workspace:*",
    "cn": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "catalog:",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@react-email/ui": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
