{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "#components",
    "utils": "#lib/utils",
    "ui": "#components/shadcn",
    "lib": "#lib",
    "hooks": "#hooks"
  },
  "registries": {
    "@assistant-ui": "https://r.assistant-ui.com/styles/{style}/{name}.json",
    "@basecn": "https://basecn.dev/r/{name}.json",
    "@better-auth-ui": "https://better-auth-ui.com/r/{style}/{name}.json",
    "@better-upload": "https://better-upload.com/r/{name}.json",
    "@extend": "https://ui.extend.ai/r/{name}.json",
    "@organui": "https://organui.com/r/styles/{style}/{name}.json",
    "@reui": {
      "headers": {
        "Authorization": "Bearer ${REUI_LICENSE_KEY}"
      },
      "url": "https://reui.io/r/{style}/{name}.json"
    }
  }
}
